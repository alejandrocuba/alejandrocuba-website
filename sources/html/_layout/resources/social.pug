-
  var social = {
    "og:site_name": profile.name,
    "og:title": `${profile.name} | Angular GDE & Principal Front-End Engineer`,
    "og:description": "Alejandro Cuba Ruiz is an Angular GDE and Principal Front-End Engineer focused in modern web architectures, technical writing, speaking, and developer mentorship.",
    "og:type": "website",
    "og:url": "https://alejandrocuba.com/",
    "og:image": "https://alejandrocuba.com/assets/images/og-image.jpg",
    "og:image:secure_url": "https://alejandrocuba.com/assets/images/og-image.jpg",
    "og:image:type": "image/jpeg",
    "og:image:width": "1200",
    "og:image:height": "630",
    "og:image:alt": `${profile.name} - Angular GDE & Principal Front-End Engineer`,
    "og:locale": "en_US",
    "twitter:card": "summary_large_image",
    "twitter:site": "@zorphdark",
    "twitter:creator": "@zorphdark",
    "twitter:title": `${profile.name} | Angular GDE & Principal Front-End Engineer`,
    "twitter:description": "Alejandro Cuba Ruiz is an Angular GDE and Principal Front-End Engineer focused in modern web architectures, technical writing, speaking, and developer mentorship.",
    "twitter:image": "https://alejandrocuba.com/assets/images/og-image.jpg",
    "twitter:image:alt": `${profile.name} - Angular GDE & Principal Front-End Engineer`
  }

for content, property in social
  if property.startsWith('og:')
    meta(property=property, content=content)
  else
    meta(name=property, content=content)
