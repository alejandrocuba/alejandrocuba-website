-
  var social = {
    "og:site_name": profile.name,
    "og:title": `${profile.name} | Principal Front-End Engineer & GDE`,
    "og:description": "Principal Front-End Engineer, Google Developer Expert in Angular, Speaker, and Top Mentor based in Miami Beach, FL.",
    "og:type": "website",
    "og:url": "https://alejandrocuba.com/",
    "og:image": "https://alejandrocuba.com/assets/images/og-image.jpg",
    "og:image:alt": `${profile.name} - Principal Front-End Engineer & GDE`,
    "og:locale": "en_US",
    "twitter:card": "summary_large_image",
    "twitter:site": "@zorphdark",
    "twitter:creator": "@zorphdark",
    "twitter:title": `${profile.name} | Principal Front-End Engineer & GDE`,
    "twitter:description": "Principal Front-End Engineer, Google Developer Expert in Angular, Speaker, and Top Mentor based in Miami Beach, FL.",
    "twitter:image": "https://alejandrocuba.com/assets/images/og-image.jpg",
    "twitter:image:alt": `${profile.name} - Principal Front-End Engineer & GDE`
  }

for content, property in social
  if property.startsWith('og:')
    meta(property=property, content=content)
  else
    meta(name=property, content=content)
