-
  var social = {
    "og:site_name": profile.name,
    "og:title": `${profile.name} | Principal Front-End Engineer & Angular GDE`,
    "og:description": "Principal Front-End Engineer and Google Developer Expert in Angular. Exploring modern web architecture, technical articles, the Angularidades podcast, conference speaking, and active mentorship.",
    "og:type": "website",
    "og:url": "https://alejandrocuba.com/",
    "og:image": "https://alejandrocuba.com/assets/images/og-image.jpg",
    "og:image:secure_url": "https://alejandrocuba.com/assets/images/og-image.jpg",
    "og:image:type": "image/jpeg",
    "og:image:width": "1200",
    "og:image:height": "630",
    "og:image:alt": `${profile.name} - Principal Front-End Engineer & Google Developer Expert in Angular`,
    "og:locale": "en_US",
    "twitter:card": "summary_large_image",
    "twitter:site": "@zorphdark",
    "twitter:creator": "@zorphdark",
    "twitter:title": `${profile.name} | Principal Front-End Engineer & Angular GDE`,
    "twitter:description": "Principal Front-End Engineer and Google Developer Expert in Angular. Exploring modern web architecture, technical articles, the Angularidades podcast, conference speaking, and active mentorship.",
    "twitter:image": "https://alejandrocuba.com/assets/images/og-image.jpg",
    "twitter:image:alt": `${profile.name} - Principal Front-End Engineer & Google Developer Expert in Angular`
  }

for content, property in social
  if property.startsWith('og:')
    meta(property=property, content=content)
  else
    meta(name=property, content=content)
