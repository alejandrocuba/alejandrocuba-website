include ../setup/path
link(rel='preconnect', href='https://fonts.googleapis.com')
link(rel='preconnect', href='https://fonts.gstatic.com', crossorigin)

block styles
  //- Load Google Fonts asynchronously to prevent render-blocking
  link(rel='preload', as='style', href='https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,400;0,9..40,500;0,9..40,600;0,9..40,700;1,9..40,400&family=Roboto+Mono:wght@400;500;600&display=swap')
  link(rel='stylesheet', href='https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,400;0,9..40,500;0,9..40,600;0,9..40,700;1,9..40,400&family=Roboto+Mono:wght@400;500;600&display=swap', media='print', onload="this.media='all'")
  noscript
    link(rel='stylesheet', href='https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,400;0,9..40,500;0,9..40,600;0,9..40,700;1,9..40,400&family=Roboto+Mono:wght@400;500;600&display=swap')

  //- Preload critical LCP above-the-fold image
  link(rel='preload', href=path.images + 'hero-speaker-hd.webp', as='image', fetchpriority='high')

  //- Main compiled styles
  link(rel='stylesheet', href=path.css + "styles.css")
