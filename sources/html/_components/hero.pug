include ../_layout/setup/path
include ../_data/profile

section#about.site-section.hero-section(aria-labelledby="hero-title")
  .container
    .hero-grid
      .hero-content
        .hero-title-group
          p.hero-intro Hi, my name is
          h1#hero-title.hero-heading= profile.name

        p.hero-bio= profile.bio

        .hero-actions
          a.btn-outline-cyan(href="#mentorship")
            span Book Mentorship
            span.arrow-indicator(aria-hidden="true") ↗

      .hero-visual
        .ambient-glow(aria-hidden="true")
        img.hero-photo(
          src=path.images + "hero-speaker.webp"
          alt="Alejandro Cuba Ruiz speaking on stage about modern web architecture and rendering"
          width="1009"
          height="1024"
          fetchpriority="high"
        )

