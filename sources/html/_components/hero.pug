include ../_layout/setup/path
include ../_data/profile

section#about.site-section.hero-section(aria-labelledby="hero-title")
  .hero-bridge-aurora(aria-hidden="true")
    svg.hero-aurora-svg(viewBox="0 0 600 600" fill="none" xmlns="http://www.w3.org/2000/svg")
      defs
        linearGradient#hero-bridge-grad(x1="30%" y1="0%" x2="70%" y2="100%")
          stop(offset="0%" stop-color="#7db3b3")
          stop(offset="50%" stop-color="#ff65e8")
          stop(offset="100%" stop-color="#abb3fb")
      path.hero-aurora-path(
        d="M 120 40 C 220 30 320 80 340 180 C 360 280 280 360 380 440 C 460 510 490 560 460 580 C 350 590 180 590 20 580 C 10 480 10 320 20 180 C 30 90 60 45 120 40 Z"
        fill="url(#hero-bridge-grad)"
      )

  .container
    .hero-grid
      .hero-content
        .hero-title-group
          p.hero-intro Hi, my name is
          h1#hero-title.hero-heading= profile.name

        p.hero-bio= profile.bio

        .hero-actions
          a.btn-outline-cyan(href="#mentorship")
            span Book Mentorship
            span.arrow-indicator(aria-hidden="true") ↗

      .hero-visual
        .ambient-glow(aria-hidden="true")
        img.hero-photo(
          src=path.images + "hero-speaker.webp"
          alt="Alejandro Cuba Ruiz speaking on stage about modern web architecture and rendering"
          width="1009"
          height="1024"
          fetchpriority="high"
        )

