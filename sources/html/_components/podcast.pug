include ../_layout/setup/path
include ../_data/podcast

- var featuredEpisode = podcast.episodes[0]

section#podcast.site-section.podcast-section(
  aria-labelledby="podcast-title"
  itemscope
  itemtype="https://schema.org/PodcastSeries"
)

  .podcast-bridge-aurora(aria-hidden="true")
    svg.podcast-aurora-svg(viewBox="0 0 600 600" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true")
      defs
        linearGradient#podcast-bridge-grad(x1="70%" y1="0%" x2="30%" y2="100%")
          stop(offset="0%" stop-color="#d28323")
          stop(offset="50%" stop-color="#e1d09a")
          stop(offset="100%" stop-color="#8480ff")
      path.podcast-aurora-path(
        d="M 480 40 C 380 30 280 80 260 180 C 240 280 320 360 220 440 C 140 510 110 560 140 580 C 250 590 420 590 580 580 C 590 480 590 320 580 180 C 570 90 540 45 480 40 Z"
        fill="url(#podcast-bridge-grad)"
      )

  .container
    .podcast-hero
      .podcast-grid
        .podcast-preview-container(
          itemprop="episode"
          itemscope
          itemtype="https://schema.org/PodcastEpisode"
        )
          meta(itemprop="name" content=featuredEpisode.title)
          meta(itemprop="url" content=`https://www.youtube.com/watch?v=${featuredEpisode.videoId}`)
          .ambient-glow(aria-hidden="true")
          .video-preview-wrapper
            button.video-facade-btn(
              type="button"
              aria-label=`Play episode preview: ${featuredEpisode.title}`
              data-video-id=featuredEpisode.videoId
            )
              img.video-thumbnail(
                src=path.images + featuredEpisode.image
                srcset=`${path.images}podcast/ep84-480w.webp 480w, ${path.images}podcast/ep84-720w.webp 720w, ${path.images}${featuredEpisode.image} 1280w`
                sizes="(max-width: 640px) 100vw, (max-width: 1024px) 50vw, 600px"
                alt=`YouTube preview for ${featuredEpisode.title}`
                width="1280"
                height="720"
                loading="lazy"
                decoding="async"
                itemprop="thumbnailUrl"
              )
              .play-button-icon(aria-hidden="true")
                svg(width="26" height="26" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true")
                  path(d="M8 5.14v13.72a1 1 0 0 0 1.54.84l11.02-6.86a1 1 0 0 0 0-1.68L9.54 4.3a1 1 0 0 0-1.54.84z")

        .podcast-info
          header.podcast-header
            span.podcast-badge Podcast
            h2#podcast-title.podcast-heading(itemprop="name" lang="es") Angularidades
            meta(itemprop="inLanguage" content="es")
            meta(itemprop="webFeed" content=podcast.links.spotify)
            meta(itemprop="url" content=podcast.links.youtube)

          dl.podcast-stats-row
            each stat in podcast.stats
              if stat.label === 'Countries'
                .podcast-stat-item.podcast-stat-item--countries
                  dt.podcast-stat-label= stat.label
                  dd.podcast-stat-num
                    span= stat.number
                    .globe-easter-egg(aria-hidden="true")
                      .globe-sphere
                        .globe-continents-track
                          svg.globe-continents-svg(viewBox="0 0 200 100" fill="none" xmlns="http://www.w3.org/2000/svg")
                            defs
                              g#globe-continents-group(fill="#34c759")
                                path(d="M 12 18 C 18 10 28 10 34 16 C 36 22 30 26 28 32 C 32 38 28 46 24 46 C 20 44 14 36 10 28 C 8 22 10 20 12 18 Z")
                                path(d="M 36 8 C 42 6 44 12 40 14 C 36 14 34 10 36 8 Z")
                                circle(cx="30" cy="40" r="1.2")
                                path(d="M 26 48 C 36 48 40 56 38 68 C 34 80 28 86 26 84 C 22 72 22 58 26 48 Z")
                                path(d="M 46 22 C 54 18 56 26 50 30 C 46 32 44 26 46 22 Z")
                                circle(cx="45" cy="18" r="1.5")
                                circle(cx="53" cy="12" r="1.8")
                                path(d="M 44 34 C 58 32 64 42 64 56 C 60 74 54 82 48 78 C 42 66 40 48 44 34 Z")
                                path(d="M 66 64 C 68 64 67 72 65 74 C 63 72 64 66 66 64 Z")
                                path(d="M 58 16 C 76 12 92 16 92 28 C 86 34 82 44 76 48 C 70 42 68 34 58 28 Z")
                                path(d="M 70 42 C 76 42 75 52 71 52 C 69 48 68 44 70 42 Z")
                                circle(cx="92" cy="28" r="2")
                                circle(cx="86" cy="56" r="1.8")
                                path(d="M 78 66 C 88 64 92 72 88 80 C 80 80 76 74 78 66 Z")
                                circle(cx="95" cy="80" r="1.5")
                            use(href="#globe-continents-group")
                            use(href="#globe-continents-group" x="100")
                        .globe-gloss-highlight
                      .globe-magnifier(aria-hidden="true")
                        svg.magnifier-svg(width="28" height="28" viewBox="0 0 28 28" fill="none" xmlns="http://www.w3.org/2000/svg")
                          defs
                            radialGradient#lens-grad(cx="35%" cy="30%" r="70%")
                              stop(offset="0%" stop-color="#38bdf8" stop-opacity="0.5")
                              stop(offset="60%" stop-color="#0284c7" stop-opacity="0.3")
                              stop(offset="100%" stop-color="#0369a1" stop-opacity="0.7")
                            linearGradient#rim-grad(x1="0%" y1="0%" x2="100%" y2="100%")
                              stop(offset="0%" stop-color="#ffffff")
                              stop(offset="50%" stop-color="#94a3b8")
                              stop(offset="100%" stop-color="#334155")
                            linearGradient#handle-grad(x1="0%" y1="0%" x2="100%" y2="100%")
                              stop(offset="0%" stop-color="#cbd5e1")
                              stop(offset="50%" stop-color="#d28323")
                              stop(offset="100%" stop-color="#7c2d12")
                          circle(cx="11" cy="11" r="7.5" fill="url(#lens-grad)" stroke="url(#rim-grad)" stroke-width="2")
                          path(d="M 16.5 16.5 L 24 24" stroke="url(#handle-grad)" stroke-width="3" stroke-linecap="round")
                          ellipse(cx="8.5" cy="8" rx="3.5" ry="1.8" fill="white" opacity="0.6" transform="rotate(-30 8.5 8)")
                      .globe-inspect-tooltip.tooltip-bubble(role="status" aria-live="polite") Trying to inspect the world?
              else
                .podcast-stat-item
                  dt.podcast-stat-label= stat.label
                  dd.podcast-stat-num= stat.number

          p.podcast-description(itemprop="description")
            | I have the privilege to host Angularidades, a podcast where I sit down with framework contributors, Google Developer Experts, and Spanish-speaking engineers to explore Angular mechanics, frontend architecture, and modern web practices.

          .podcast-actions
            ul.podcast-platform-list(role="list" aria-label="Podcast platforms and episode archive")
              li.podcast-platform-item.podcast-platform-item--primary
                a.btn.btn-secondary.btn-youtube-cta(
                  href=podcast.links.youtube
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label="View all Angularidades episodes on YouTube"
                )
                  svg.platform-icon.platform-youtube-icon(width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true")
                    path(d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z")
                  span View all episodes
                  span.arrow-indicator(aria-hidden="true") ↗

              li.podcast-platform-item.podcast-platform-item--secondary
                a.btn.btn-secondary.btn-icon.platform-spotify(
                  href=podcast.links.spotify
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label="View episodes on Spotify"
                  data-tooltip="View episodes on Spotify"
                )
                  svg.platform-icon(width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true")
                    path(d="M12 0C5.373 0 0 5.373 0 12s5.373 12 12 12 12-5.373 12-12S18.627 0 12 0zm5.494 17.306c-.215.352-.676.463-1.028.248-2.857-1.745-6.455-2.14-10.69-1.173-.404.093-.812-.162-.904-.567-.094-.404.162-.812.567-.905 4.636-1.059 8.608-.61 11.808 1.348.352.215.463.676.247 1.047zm1.467-3.26c-.27.44-.847.579-1.287.31-3.27-2.008-8.254-2.59-12.12-1.416-.497.15-1.025-.133-1.176-.63-.15-.497.133-1.024.63-1.176 4.417-1.341 9.907-.69 13.643 1.605.44.27.579.847.31 1.287zm.126-3.41c-3.921-2.328-10.378-2.541-14.11-1.408-.6.182-1.24-.162-1.422-.763-.182-.6.163-1.24.764-1.422 4.29-1.302 11.416-1.054 15.932 1.626.54.321.716 1.027.396 1.567-.321.54-1.027.717-1.56.396z")

                a.btn.btn-secondary.btn-icon.platform-apple(
                  href=podcast.links.apple
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label="View episodes on Apple Podcasts"
                  data-tooltip="View episodes on Apple Podcasts"
                )
                  svg.platform-icon(width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true")
                    path(d="M12 1.5A10.5 10.5 0 0 0 1.5 12a10.5 10.5 0 0 0 10.5 10.5A10.5 10.5 0 0 0 22.5 12 10.5 10.5 0 0 0 12 1.5zm0 3a7.5 7.5 0 0 1 5.3 12.8l-1.4-1.4a5.5 5.5 0 0 0-7.8 0l-1.4 1.4A7.5 7.5 0 0 1 12 4.5zm0 3.5a4 4 0 0 1 2.8 6.8l-1.4-1.4a2 2 0 0 0-2.8 0l-1.4 1.4A4 4 0 0 1 12 8zm0 2.5a1.5 1.5 0 1 0 0 3 1.5 1.5 0 0 0 0-3zm-1 5.5h2v4h-2z")
