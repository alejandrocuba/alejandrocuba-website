include ../_data/articles
include ../_data/profile

mixin articleCard(article)
  article.card(itemscope itemtype="http://schema.org/TechArticle")
    h3.card-title(itemprop="headline")
      a.card-title-link(href=article.url target="_blank" rel="noopener noreferrer")
        = article.title

    p.card-description(itemprop="description")= article.description

    .card-meta
      .card-meta-left
        time(datetime=article.date itemprop="datePublished")= article.formattedDate
        span.meta-dot(aria-hidden="true") •
        span= article.readTime
      .card-meta-right
        a.card-link-arrow(
          href=article.url
          target="_blank"
          rel="noopener noreferrer"
          aria-label=`Read "${article.title}" on Medium`
        )
          | Read on Medium ↗

section#articles.site-section(aria-labelledby="articles-title")
  .container
    header.section-header
      span.section-label Recent Articles
      h2#articles-title.section-title Technical Articles

    .articles-grid
      each article in articles
        +articleCard(article)

    .section-footer-actions
      a.btn.btn-secondary(
        href="https://medium.com/@alejandrocuba/list/frontend-dev-articles-efd1b199a75d"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="View Alejandro Cuba's technical articles on Medium"
      )
        span View all articles
        span.arrow-indicator(aria-hidden="true") ↗
