include ../_data/profile

section#contact.site-section(aria-labelledby="contact-title")
  .container
    .contact-card
      .ambient-glow(aria-hidden="true")
      span.section-label Get In Touch
      h2#contact-title.contact-heading Let's Connect
      p.contact-subtext
        | Open for technical advisory, keynote speaking engagements, design system consulting, and high-impact engineering leadership.

      .contact-actions
        a.btn.btn-primary.contact-linkedin-btn(
          href=profile.socials.linkedin
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Connect with Alejandro Cuba on LinkedIn"
        )
          span Connect on LinkedIn
          span.arrow-indicator(aria-hidden="true") ↗

      nav.social-channels-bar(aria-label="Online profiles and social channels")
        a.channel-link(href=profile.socials.github target="_blank" rel="noopener noreferrer") GitHub
        a.channel-link(href=profile.socials.linkedin target="_blank" rel="noopener noreferrer") LinkedIn
        a.channel-link(href=profile.socials.medium target="_blank" rel="noopener noreferrer") Medium
        a.channel-link(href=profile.socials.youtube target="_blank" rel="noopener noreferrer") YouTube
        a.channel-link(href=profile.socials.sessionize target="_blank" rel="noopener noreferrer") Sessionize
        a.channel-link(href=profile.socials.adplist target="_blank" rel="noopener noreferrer") ADPList
        a.channel-link(href=profile.socials.bluesky target="_blank" rel="noopener noreferrer") Bluesky
