section#mentorship.site-section.mentorship-section(aria-labelledby="mentorship-title")
  .mentorship-aurora(aria-hidden="true")
    svg.mentorship-aurora-svg(viewBox="0 0 600 680" fill="none" xmlns="http://www.w3.org/2000/svg")
      defs
        linearGradient#mentorship-linear-grad(x1="65%" y1="0%" x2="30%" y2="100%")
          stop(offset="0%" stop-color="#9AFF9F")
          stop(offset="100%" stop-color="#5D6799")
      path.aurora-path(
        d="M 400 30 C 490 20 570 60 585 160 C 595 240 590 440 590 660 C 440 680 240 680 30 660 C 20 570 100 480 210 410 C 310 360 365 260 360 150 C 355 80 370 40 400 30 Z"
        fill="url(#mentorship-linear-grad)"
      )

  .container
    .mentorship-content
      header.section-header
        span.section-label Engineering Leadership
        h2#mentorship-title.section-title Mentorship
      p.mentorship-narrative Dedicated to fostering growth and empowering engineers and design system leaders worldwide. Providing actionable guidance on frontend architecture, career progression, design systems, and public speaking through structured 1-on-1 mentorship.

      .mentorship-actions
        a.btn.btn-secondary(href="https://adplist.org/mentors/alejandro-cuba" target="_blank" rel="noopener noreferrer")
          span Book Mentorship
          span.arrow-indicator(aria-hidden="true") ↗


