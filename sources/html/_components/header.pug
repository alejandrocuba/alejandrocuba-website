include ../_layout/setup/path

header.site-header
  .container.header-container
    a.nav-logo(href="#about" aria-label="Alejandro Cuba - Home")
      img.nav-logo-img(
        src=path.images + "logo.png"
        alt="Alejandro Cuba"
        width="32"
        height="32"
        fetchpriority="high"
      )

    nav.site-nav(aria-label="Main Navigation")
      ul.nav-list
        li.nav-item
          details.nav-dropdown
            summary.nav-link.nav-dropdown-trigger(aria-haspopup="true")
              span Contributions
              svg.dropdown-caret(width="8" height="6" viewBox="0 0 8 6" fill="currentColor" aria-hidden="true")
                path(d="M0 1L4 5L8 1H0Z")
            ul.dropdown-menu(role="menu")
              li(role="none")
                a.dropdown-link(href="#articles" role="menuitem") Articles
              li(role="none")
                a.dropdown-link(href="#podcast" role="menuitem") Podcast
              li(role="none")
                a.dropdown-link(href="#speaking" role="menuitem") Speaking
              li(role="none")
                a.dropdown-link(href="#mentorship" role="menuitem") Mentorship

        li.nav-item
          a.nav-link(href="#contact") Contact
