include ../_data/tech-stack

section#behind-the-website.site-section.tech-stack-section(aria-labelledby="tech-stack-title")
  .container
    .tech-stack-wrapper
      .tech-stack-header
        div
          span.section-label Behind The Website
          h2#tech-stack-title.tech-stack-heading How This Site Is Built
        p.tech-stack-subtext
          | Architected as a high-performance static site with zero heavy framework runtime, adhering to strict WCAG 2.2 accessibility standards and modern CSS primitives.

      dl.tech-badges-list(aria-label="Website quality and performance metrics")
        each badge in siteTechStack.badges
          .tech-badge-item
            dt.badge-label
              if badge.icon === 'license'
                svg.badge-icon(width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true")
                  path(d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z")
              else if badge.icon === 'speed'
                svg.badge-icon(width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true")
                  polygon(points="13 2 3 14 12 14 11 22 21 10 12 10 13 2")
              else if badge.icon === 'a11y'
                svg.badge-icon(width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true")
                  circle(cx="12" cy="4" r="2")
                  path(d="M12 8v6")
                  path(d="M8 10h8")
                  path(d="m9 20 3-6 3 6")
              else if badge.icon === 'feather'
                svg.badge-icon(width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true")
                  path(d="M20.24 12.24a6 6 0 0 0-8.49-8.49L5 10.5V19h8.5z")
                  line(x1="16" y1="8" x2="2" y2="22")
                  line(x1="17.5" y1="15" x2="9" y2="15")
              span= badge.label
            dd.badge-value= badge.value

      .tech-grid
        each tech in siteTechStack.technologies
          article.tech-card
            .tech-card-top
              span.tech-category= tech.category
              h3.tech-name= tech.name
            p.tech-desc= tech.description

      .tech-stack-footer
        a.btn.btn-secondary.tech-github-btn(
          href=siteTechStack.githubUrl
          target="_blank"
          rel="noopener noreferrer"
          aria-label="View website source code repository on GitHub"
        )
          svg.platform-icon(width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true")
            path(fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z")
          span View Source on GitHub
          span.arrow-indicator(aria-hidden="true") ↗
